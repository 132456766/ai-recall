# Recall 运行配置示例（复制为 .env 后按需修改）
# API 运行模式：
#   mock = 本地模拟（IndexedDB + Mock AI），无需后端，默认
#   real = 对接真实后端，启用 src/services/api.real.js 与 src/lib/bendApi.js
VITE_API_MODE=mock

# 真实后端基地址（仅 VITE_API_MODE=real 时生效）
# 端点契约见 src/services/contract.js（与开发规划文档「第四章 API 契约」对齐）
VITE_API_BASE=http://localhost:8080
